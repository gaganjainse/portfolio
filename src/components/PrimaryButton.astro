---
import Icon from './Icon.astro'

interface Props {
  href: string
  label: string
  icon?:
    | 'folder'
    | 'github'
    | 'linkedin'
    | 'doc'
    | 'download'
    | 'mail'
    | 'phone'
    | 'external'
    | 'home-solid'
  external?: boolean
  compact?: boolean
}
const { href, label, icon = 'external', external = false, compact = false } = Astro.props
// Responsive padding: snug on phones (so the hero CTA stack stays short),
// roomier from sm up. compact stays tiny for dense spots (e.g. hero PDF link).
const pad = compact ? 'px-4 py-2.5' : 'px-5 py-2.5 sm:px-8 sm:py-3.5'
---

<a
  href={href}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  class={`group relative ${pad} rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition hover:shadow-lg hover:shadow-primary/25 hover:-translate-y-0.5 overflow-hidden`}
>
  <span class="relative z-10 flex items-center gap-2">
    <Icon name={icon} class="w-5 h-5" />
    <span>{label}</span>
  </span>
  <div
    class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity"
  >
  </div>
</a>

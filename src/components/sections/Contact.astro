---
import { SITE_CONFIG } from '../../data/config.ts'
import SectionHeading from '../SectionHeading.astro'
import PrimaryButton from '../PrimaryButton.astro'
---

<section
  id="contact"
  class="py-24 px-4 sm:px-6 bg-bg-elevated/50"
  aria-labelledby="contact-heading"
>
  <div class="max-w-4xl mx-auto text-center contact-section">
    <div class="flex flex-col items-center">
      <SectionHeading id="contact-heading" title="Get In" accent="Touch" dividerClass="mb-8" />
    </div>

    <p class="text-text-muted text-lg mb-8 max-w-2xl mx-auto">
      I'm currently looking for GenAI / LLM / Agentic AI roles. If you're hiring or just want to
      connect, feel free to reach out.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
      <PrimaryButton href={`mailto:${SITE_CONFIG.email}`} label={SITE_CONFIG.email} icon="mail" />
      <PrimaryButton href={`tel:${SITE_CONFIG.phone}`} label={SITE_CONFIG.phone} icon="phone" />
      <PrimaryButton
        href="https://linkedin.com/in/gaganjainse"
        label="LinkedIn"
        icon="linkedin"
        external
      />
    </div>

    <p class="text-text-muted text-sm">{SITE_CONFIG.location} &middot; Open to relocation</p>
  </div>
</section>

<script>
  import gsap from 'gsap'
  import { prefersReducedMotion } from '../../utils/dom.ts'

  if (!prefersReducedMotion()) {
    gsap.from('.contact-section > *', {
      scrollTrigger: {
        trigger: '.contact-section',
        start: 'top 80%',
        once: true,
      },
      opacity: 0,
      y: 30,
      duration: 0.7,
      stagger: 0.15,
      ease: 'power3.out',
    })
  }
</script>

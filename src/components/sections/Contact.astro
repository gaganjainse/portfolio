---
import { SITE_CONFIG, SOCIAL_LINKS } from '../../data/config.ts'
import SectionHeading from '../SectionHeading.astro'
---

<section
  id="contact"
  class="py-24 px-4 sm:px-6 bg-bg-elevated/50"
  aria-labelledby="contact-heading"
>
  <div class="max-w-4xl mx-auto text-center contact-section">
    <div class="gradient-border p-6 sm:p-8">
      <div class="flex flex-col items-center">
        <SectionHeading id="contact-heading" title="Get In" accent="Touch" dividerClass="mb-8" />
      </div>

      <p class="text-text-muted text-lg mb-8 max-w-2xl mx-auto">
        I'm currently looking for GenAI / LLM / Agentic AI roles. If you're hiring or just want to
        connect, feel free to reach out.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
        <a
          href={`mailto:${SITE_CONFIG.email}`}
          class="group relative px-8 py-3.5 rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition hover:shadow-lg hover:shadow-primary/25 overflow-hidden"
        >
          <span class="relative z-10 flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
              ></path></svg
            >
            {SITE_CONFIG.email}
          </span>
          <div
            class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>
        </a>
        <a
          href={`tel:${SITE_CONFIG.phone}`}
          class="group relative px-8 py-3.5 rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition hover:shadow-lg hover:shadow-primary/25 overflow-hidden"
        >
          <span class="relative z-10 flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
              ></path></svg
            >
            {SITE_CONFIG.phone}
          </span>
          <div
            class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>
        </a>
        {
          SOCIAL_LINKS.filter((l) => l.name === 'LinkedIn').map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative px-8 py-3.5 rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition hover:shadow-lg hover:shadow-primary/25 overflow-hidden"
            >
              <span class="relative z-10 flex items-center gap-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                {link.name}
              </span>
              <div class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity" />
            </a>
          ))
        }
      </div>

      <p class="text-text-muted text-sm">
        {SITE_CONFIG.location} &middot; Open to relocation
      </p>
    </div>
  </div>
</section>

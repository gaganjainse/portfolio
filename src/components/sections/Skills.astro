---
import { groupByCategory, SKILLS, getProficiencyLabel } from '../../data/skills.ts'
import SectionHeading from '../SectionHeading.astro'
---

<section id="skills" class="py-24 px-4 sm:px-6 bg-bg-elevated/50" aria-labelledby="skills-heading">
  <div class="max-w-6xl mx-auto">
    <SectionHeading id="skills-heading" title="Technical" accent="Skills" dividerClass="mb-12" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        Object.values(groupByCategory(SKILLS)).map((data) => (
          <div class="gradient-border p-6 transition">
            <h3 class="text-lg font-semibold text-text mb-4 flex items-center gap-2">
              <span
                class="w-3 h-3 rounded-full"
                style={{ backgroundColor: data.color }}
                aria-hidden="true"
              />
              {data.name}
            </h3>
            <div class="space-y-3">
              {data.skills.map((skill) => (
                <div>
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-sm text-text">{skill.name}</span>
                    <span class="text-xs text-text-muted">{getProficiencyLabel(skill.level)}</span>
                  </div>
                  <div
                    class="h-1.5 bg-bg rounded-full overflow-hidden"
                    role="progressbar"
                    aria-valuenow={skill.level}
                    aria-valuemin={0}
                    aria-valuemax={100}
                    aria-label={`${skill.name}: ${getProficiencyLabel(skill.level)}`}
                  >
                    <div
                      class="h-full rounded-full skill-bar-fill"
                      style={{ '--bar-color': data.color, '--target-width': `${skill.level}%` }}
                      data-width={`${skill.level}%`}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { prefersReducedMotion } from '../../utils/dom.ts'

  if (!prefersReducedMotion()) {
    document.querySelectorAll<HTMLElement>('.skill-bar-fill').forEach((bar) => {
      const target = bar.dataset.width
      if (!target) return

      gsap.killTweensOf(bar)
      ScrollTrigger.getAll().forEach((st) => {
        if (st.trigger === bar) st.kill()
      })

      gsap.set(bar, { width: '0%' })

      gsap.to(bar, {
        width: target,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: bar,
          start: 'top 90%',
          once: true,
        },
      })
    })
  }
</script>

---
import { SITE_CONFIG } from '../../data/config.ts'
import SectionHeading from '../SectionHeading.astro'
import Pill from '../Pill.astro'
---

<section id="about" class="py-24 px-4 sm:px-6" aria-labelledby="about-heading">
  <div class="max-w-4xl mx-auto about-section">
    <SectionHeading id="about-heading" title="About" accent="Me" />

    <div class="gradient-border p-6 sm:p-8">
      <div class="space-y-4 text-text-muted text-lg leading-relaxed">
        <p>
          I'm a Computer Science graduate from <span class="text-text font-medium">VIT Vellore</span
          >{' '}(graduated{' '}{SITE_CONFIG.graduation}), focused on building{' '}
          <span class="text-text font-medium">production-grade GenAI systems</span> — from RAG pipelines
          and fine-tuned models to multi-agent orchestration and agentic AI platforms.
        </p>

        <p>
          My key projects include{' '}
          <a href="/docs/projects/seshaos" class="text-primary-light font-medium hover:underline"
            >SheshAOS</a
          >{' '}(a governance-first, event-sourced AI operating environment in Rust),{' '}
          <a
            href="/docs/projects/rag-service"
            class="text-primary-light font-medium hover:underline">RAG Service</a
          >{' '}(a hybrid-retrieval RAG API), and{' '}
          <a
            href="/docs/projects/llm-eval-harness"
            class="text-primary-light font-medium hover:underline">LLM Eval Harness</a
          >{' '}(golden-set evaluation for LLM outputs). I've also built{' '}
          <a href="/docs/projects/vyakrti" class="text-primary-light font-medium hover:underline"
            >Vyākṛti</a
          >{' '}(a complete programming language with compiler and browser IDE),{' '}
          <a href="/docs/projects/shesh-ecosystem" class="text-primary-light font-medium hover:underline">shesh-ecosystem</a>{
            ' '
          }(a local-first AI body),{' '}
          <a href="/#projects" class="text-primary-light font-medium hover:underline">AIM</a>{' '}(a
          production attendance platform), and{' '}
          <a href="/#projects" class="text-primary-light font-medium hover:underline">FWRS</a>{
            ' '
          }(a food-waste optimization platform) — plus{' '}
          <a
            href="/docs/projects/shesh-omniroute"
            class="text-primary-light font-medium hover:underline">shesh-omniroute</a
          >{' '}(a free AI-model gateway).
        </p>

        <p>
          I've also completed an Industry 5.0 industrial automation training internship, working
          with PLCs (CODESYS), process simulation (Factory I/O), and Node-RED — giving me hands-on
          exposure to industrial systems alongside my AI work.
        </p>

        <p>
          I'm looking for <span class="text-text">GenAI / LLM Engineer</span>,{' '}
          <span class="text-text">Agentic AI Engineer</span>, or{' '}
          <span class="text-text">AI Engineer</span> roles. Based in {SITE_CONFIG.location} and open to
          relocation.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          [
            `B.Tech CSE, VIT Vellore`,
            `Graduated ${SITE_CONFIG.graduation}`,
            SITE_CONFIG.location,
            'Open to relocation',
            'GenAI / LLM',
            'Agentic AI',
            'RAG Systems',
            'Rust & Python',
          ].map((tag) => <Pill label={tag} variant="tag" />)
        }
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap'
  import { prefersReducedMotion } from '../../utils/dom.ts'

  if (!prefersReducedMotion()) {
    gsap.from('.about-section > *', {
      scrollTrigger: {
        trigger: '.about-section',
        start: 'top 80%',
        once: true,
      },
      opacity: 0,
      y: 30,
      duration: 0.8,
      stagger: 0.15,
      ease: 'power3.out',
    })
  }
</script>

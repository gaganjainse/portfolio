---
import { SITE_CONFIG, SOCIAL_LINKS } from '../../data/config.js'
---

<section id="home" class="min-h-screen flex items-center justify-center relative overflow-hidden pt-24 sm:pt-28" aria-label="Hero">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl animate-pulse-glow" />
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-accent/10 rounded-full blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;" />
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;" />
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center">
    <div class="mb-6">
      <img
        src="/profile.jpg"
        alt="Gagan Jain"
        width="144"
        height="144"
        class="w-28 h-28 sm:w-36 sm:h-36 rounded-full mx-auto object-cover border-4 border-primary/30 shadow-2xl shadow-primary/20"
      />
    </div>
    <div class="hero-badge mb-6">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium bg-success/10 text-success border border-success/20 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-success animate-pulse" aria-hidden="true" />
        {SITE_CONFIG.availability}
      </span>
    </div>

    <h1 class="hero-name text-5xl sm:text-6xl md:text-7xl font-bold mb-4 leading-tight tracking-tight">
      Hi, I'm <span class="gradient-text">{SITE_CONFIG.name}</span>
    </h1>

    <p class="hero-tagline text-xl sm:text-2xl text-text-muted mb-4 max-w-3xl mx-auto leading-relaxed">
      {SITE_CONFIG.tagline}
    </p>

    <p class="text-base text-text-muted/70 mb-10 max-w-xl mx-auto">
      CS @ VIT Vellore &middot; GenAI / LLM / Agentic AI — RAG, fine-tuning, multi-agent orchestration, and production AI platforms
    </p>

    <div class="hero-stats grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 max-w-3xl mx-auto mb-10">
      <div class="glass rounded-xl p-4 sm:p-5">
        <div class="text-2xl sm:text-3xl font-bold gradient-text stat-value">12+</div>
        <div class="text-xs sm:text-sm text-text-muted mt-1">AI Projects</div>
      </div>
      <div class="glass rounded-xl p-4 sm:p-5">
        <div class="text-2xl sm:text-3xl font-bold gradient-text stat-value">16</div>
        <div class="text-xs sm:text-sm text-text-muted mt-1">GitHub Repos</div>
      </div>
      <div class="glass rounded-xl p-4 sm:p-5">
        <div class="text-2xl sm:text-3xl font-bold gradient-text stat-value">1,200+</div>
        <div class="text-xs sm:text-sm text-text-muted mt-1">Tests Written</div>
      </div>
      <div class="glass rounded-xl p-4 sm:p-5">
        <div class="text-2xl sm:text-3xl font-bold gradient-text stat-value">7.7/10</div>
        <div class="text-xs sm:text-sm text-text-muted mt-1">CGPA</div>
      </div>
    </div>

    <div class="hero-cta flex flex-wrap items-center justify-center gap-4 mb-8">
      <a
        href="/#projects"
        class="group relative px-8 py-3.5 rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition-all hover:shadow-lg hover:shadow-primary/25 hover:-translate-y-0.5 overflow-hidden"
      >
        <span class="relative z-10 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
          View Projects
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity" />
      </a>
      <a
        href="https://github.com/gaganjainse"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative px-8 py-3.5 rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition-all hover:shadow-lg hover:shadow-primary/25 hover:-translate-y-0.5 overflow-hidden"
      >
        <span class="relative z-10 flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity" />
      </a>
      <a
        href="https://linkedin.com/in/gaganjainse"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative px-8 py-3.5 rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition-all hover:shadow-lg hover:shadow-primary/25 hover:-translate-y-0.5 overflow-hidden"
      >
        <span class="relative z-10 flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity" />
      </a>
      <a
        href="/resume"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative px-8 py-3.5 rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition-all hover:shadow-lg hover:shadow-primary/25 hover:-translate-y-0.5 overflow-hidden"
      >
        <span class="relative z-10 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Resume
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity" />
      </a>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative px-3 py-3.5 rounded-xl font-medium bg-primary text-white hover:bg-primary-light transition-all hover:shadow-lg hover:shadow-primary/25 hover:-translate-y-0.5 overflow-hidden"
        aria-label="Download Resume PDF"
      >
        <span class="relative z-10 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Resume
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-primary-light to-accent opacity-0 group-hover:opacity-100 transition-opacity" />
      </a>
    </div>
  </div>
</section>

<script is:inline>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!prefersReducedMotion) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } })
    tl.from('.hero-badge', { opacity: 0, y: 20, duration: 0.6 })
      .from('.hero-name', { opacity: 0, y: 30, duration: 0.7 }, '-=0.3')
      .from('.hero-tagline', { opacity: 0, y: 20, duration: 0.6 }, '-=0.4')
      .from('.hero-stats', { opacity: 0, y: 20, duration: 0.6 }, '-=0.3')
      .from('.hero-cta', { opacity: 0, y: 20, duration: 0.5 }, '-=0.3')
  }
</script>

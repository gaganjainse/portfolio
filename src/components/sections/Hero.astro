---
import { SITE_CONFIG } from '../../data/config.ts'
import { PROJECTS } from '../../data/projects.ts'
import { Image } from 'astro:assets'
import profilePic from '../../assets/profile.jpg'
import PrimaryButton from '../PrimaryButton.astro'

// Data-driven hero stats: project count + tests come from the data files,
// GitHub repo count is fetched at build time with a config fallback.
const projectCount = PROJECTS.length
const testCount = PROJECTS.reduce((sum, p) => sum + (p.tests ?? 0), 0)
const testsDisplay = testCount > 0 ? `${Math.floor(testCount / 100) * 100}+` : '100+'

const statPillClass =
  'px-3 py-1.5 rounded-full text-sm font-medium bg-bg border border-border text-text-muted cursor-default hover:text-primary-light hover:border-primary/30 hover:shadow-[0_0_8px_rgba(124,58,237,0.3)] transition'

let repoCount = SITE_CONFIG.defaultRepoCount
try {
  const res = await fetch(`https://api.github.com/users/${SITE_CONFIG.githubUsername}`, {
    headers: { 'User-Agent': 'portfolio-build', Accept: 'application/vnd.github+json' },
  })
  if (res.ok) {
    const data = await res.json()
    if (typeof data.public_repos === 'number' && data.public_repos > 0) {
      repoCount = data.public_repos
    }
  }
} catch {
  // Network failure at build time — fall back to the config value.
}
---

<section
  id="home"
  class="min-h-screen flex items-center justify-center relative pt-24 sm:pt-28 pb-12 sm:pb-14 bg-bg-elevated/50"
  aria-label="Hero"
>
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6">
    <div class="gradient-border p-4 sm:p-6 text-center">
      <div class="mb-3 sm:mb-4">
        <Image
          src={profilePic}
          alt="Gagan Jain"
          width={144}
          height={144}
          format="webp"
          quality={85}
          class="w-24 h-24 sm:w-28 sm:h-28 rounded-full mx-auto object-cover border-4 border-primary/30 shadow-2xl shadow-primary/20"
        />
      </div>
      <div class="hero-badge mb-3 sm:mb-4">
        <span
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium bg-success/10 text-success border border-success/20 cursor-default hover:text-success hover:shadow-[0_0_8px_rgba(16,185,129,0.3)] transition"
        >
          <span class="w-2 h-2 rounded-full bg-success animate-pulse" aria-hidden="true"></span>
          {SITE_CONFIG.availability}
        </span>
      </div>

      <h1
        class="hero-name text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-2 sm:mb-3 leading-tight tracking-tight"
      >
        Hi, I'm <span class="gradient-text">{SITE_CONFIG.name}</span>
      </h1>

      <p
        class="hero-tagline text-lg sm:text-2xl text-text-muted mb-2 sm:mb-3 max-w-3xl mx-auto leading-relaxed"
      >
        {SITE_CONFIG.tagline}
      </p>

      <div
        class="hero-stats flex flex-wrap items-center justify-center gap-3 max-w-3xl mx-auto mb-4 sm:mb-6"
      >
        <span class={statPillClass}>
          <span class="gradient-text font-bold">{projectCount}</span> Projects
        </span>
        <span class={statPillClass}>
          <span class="gradient-text font-bold">{repoCount}</span> GitHub Repos
        </span>
        <span class={statPillClass}>
          <span class="gradient-text font-bold">{testsDisplay}</span> Tests Written
        </span>
      </div>

      <div class="hero-cta flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-0 sm:mb-4">
        <PrimaryButton href="/#projects" label="View Projects" icon="folder" />
        <PrimaryButton
          href="https://github.com/gaganjainse"
          label="GitHub"
          icon="github"
          external
        />
        <PrimaryButton
          href="https://linkedin.com/in/gaganjainse"
          label="LinkedIn"
          icon="linkedin"
          external
        />
        <PrimaryButton href="/resume" label="Résumé" icon="doc" />
        <PrimaryButton href="/resume.pdf" label="PDF" icon="download" external compact />
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap'
  import { prefersReducedMotion } from '../../utils/dom.ts'

  if (!prefersReducedMotion()) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } })
    tl.from('.hero-badge', { opacity: 0, y: 20, duration: 0.6 })
      .from('.hero-name', { opacity: 0, y: 30, duration: 0.7 }, '-=0.3')
      .from('.hero-tagline', { opacity: 0, y: 20, duration: 0.6 }, '-=0.4')
      .from('.hero-stats', { opacity: 0, y: 20, duration: 0.6 }, '-=0.3')
      .from('.hero-cta', { opacity: 0, y: 20, duration: 0.5 }, '-=0.3')
  }
</script>

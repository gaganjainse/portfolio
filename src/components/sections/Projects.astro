---
import { PROJECTS, getTagClasses } from '../../data/projects.ts'
---

<section
  id="projects"
  class="py-24 px-4 sm:px-6 bg-bg-elevated/50"
  aria-labelledby="projects-heading"
>
  <div class="max-w-6xl mx-auto">
    <h2 id="projects-heading" class="text-3xl sm:text-4xl font-bold mb-2">
      Featured <span class="gradient-text">Projects</span>
    </h2>
    <div class="w-20 h-1 bg-gradient-to-r from-primary to-accent rounded-full mb-8"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {
        PROJECTS.map((project) => (
          <article class="project-card gradient-border p-6 sm:p-8 transition">
            <span
              class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-bold mb-3 ${getTagClasses(project.tagColor)}`}
            >
              {project.tag}
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-text mb-3">{project.title}</h3>
            <p class="text-text-muted mb-4">{project.description}</p>
            <ul class="space-y-2 mb-4">
              {project.bullets.map((bullet) => (
                <li class="text-sm text-text-muted flex items-start gap-2">
                  <span class="text-primary mt-[0.25em] shrink-0" aria-hidden="true">
                    ▸
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tech.map((tech) => (
                <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-bg text-text-muted border border-border cursor-default transition hover:shadow-[0_0_6px_rgba(148,163,184,0.2)] hover:border-border-light">
                  {tech}
                </span>
              ))}
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium bg-bg text-text-muted border border-border transition hover:text-text hover:border-primary/40 hover:shadow-[0_0_10px_rgba(124,58,237,0.25)]"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
                Source Code
              </a>
              {project.docs && (
                <a
                  href={project.docs}
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium bg-bg text-text-muted border border-border transition hover:text-text hover:border-primary/40 hover:shadow-[0_0_10px_rgba(124,58,237,0.25)]"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                  Documentation
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { useScrollReveal } from '../../utils/gsap.ts'

  useScrollReveal({
    selector: '.project-card',
    trigger: '#projects',
    start: 'top 80%',
    once: true,
    opacity: 0,
    y: 30,
    duration: 0.6,
    stagger: 0.1,
    ease: 'power3.out',
  })
</script>

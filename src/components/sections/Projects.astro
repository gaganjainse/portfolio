---
import { PROJECTS, getTagClasses } from '../../data/projects.ts'
import SectionHeading from '../SectionHeading.astro'
import TechChip from '../TechChip.astro'
import ProjectLinkButton from '../ProjectLinkButton.astro'

function companionDocs(project: (typeof PROJECTS)[number]) {
  if (!project.companionOf) return null
  const found = PROJECTS.find((p) => p.title === project.companionOf)
  return found?.docs ?? null
}
---

<section
  id="projects"
  class="py-24 px-4 sm:px-6 bg-bg-elevated/50"
  aria-labelledby="projects-heading"
>
  <div class="max-w-6xl mx-auto">
    <SectionHeading id="projects-heading" title="Featured" accent="Projects" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {
        PROJECTS.map((project) => (
          <article class="project-card gradient-border p-6 sm:p-8 transition flex flex-col">
            <span
              class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-bold mb-3 ${getTagClasses(project.tagColor)}`}
            >
              {project.tag}
            </span>
            <h3 class="text-xl sm:text-2xl font-bold text-text mb-3">{project.title}</h3>
            {project.companionOf && (
              <p class="text-xs font-medium text-primary-light mb-2">
                Companion to{' '}
                {companionDocs(project) ? (
                  <a href={companionDocs(project)} class="hover:underline">
                    {project.companionOf}
                  </a>
                ) : (
                  <span>{project.companionOf}</span>
                )}
              </p>
            )}
            <p class="text-text-muted mb-4">{project.description}</p>
            <ul class="space-y-2 mb-4">
              {project.bullets.map((bullet) => (
                <li class="text-sm text-text-muted flex items-start gap-2">
                  <span class="text-primary mt-[0.25em] shrink-0" aria-hidden="true">
                    ▸
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tech.map((tech) => (
                <TechChip label={tech} />
              ))}
            </div>
            <div class="mt-auto pt-5 border-t border-border/60 flex flex-wrap items-center gap-3">
              <ProjectLinkButton href={project.github} label="Source Code" icon="github" external />
              {project.docs && (
                <ProjectLinkButton href={project.docs} label="Documentation" icon="doc" />
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { useScrollReveal } from '../../utils/gsap.ts'

  useScrollReveal({
    selector: '.project-card',
    trigger: '#projects',
    start: 'top 80%',
    once: true,
    opacity: 0,
    y: 30,
    duration: 0.6,
    stagger: 0.1,
    ease: 'power3.out',
  })
</script>

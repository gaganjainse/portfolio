---
interface Props {
  current?: string
}
const { current = '' } = Astro.props

const DOCS = [
  { href: '/docs/getting-started', label: 'Getting Started' },
  { href: '/docs/architecture', label: 'Architecture' },
  { href: '/docs/adr', label: 'ADRs' },
  { href: '/docs/projects/nexusaos', label: 'NexusAOS' },
  { href: '/docs/projects/nexus-kernel', label: 'nexus-kernel' },
  { href: '/docs/projects/seshaos', label: 'SeshaOS' },
  { href: '/docs/projects/rag-service', label: 'RAG Service' },
  { href: '/docs/projects/llm-eval-harness', label: 'LLM Eval Harness' },
  { href: '/docs/projects/vyakrti', label: 'Vyākṛti' },
  { href: '/docs/projects/aim', label: 'AIM' },
  { href: '/docs/projects/fwrs', label: 'FWRS' },
]
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 pt-8">
  <nav class="text-sm text-text-muted mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-text transition-colors">Home</a>
    <span class="mx-2 text-border" aria-hidden="true">/</span>
    <a href="/docs/getting-started" class="hover:text-text transition-colors">Docs</a>
    {
      current && (
        <>
          <span class="mx-2 text-border" aria-hidden="true">
            /
          </span>
          <span class="text-text">{current}</span>
        </>
      )
    }
  </nav>
  <nav class="flex flex-wrap gap-2 mb-6" aria-label="Docs navigation">
    {
      DOCS.map((doc) => (
        <a
          href={doc.href}
          class={`px-3 py-1.5 rounded-full text-xs font-medium border transition ${
            doc.label === current
              ? 'bg-primary/20 text-primary-light border-primary/40'
              : 'bg-bg text-text-muted border-border hover:text-text hover:border-primary/40'
          }`}
        >
          {doc.label}
        </a>
      ))
    }
  </nav>
</div>

---

{
  FILLED[name] && (
    <svg id={id} class={className} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d={FILLED[name]} />
    </svg>
  )
}
{
  STROKED[name] && (
    <svg
      id={id}
      class={className}
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={STROKED[name]} />
    </svg>
  )
}

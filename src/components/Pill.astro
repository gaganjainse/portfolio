---
interface Props {
  label: string
  variant?: 'neutral' | 'tag' | 'period'
}
const { label, variant = 'neutral' } = Astro.props
const cls =
  variant === 'tag'
    ? 'px-3 py-1 rounded-full text-sm bg-bg-card border border-border text-text-muted cursor-default transition hover:shadow-[0_0_6px_rgba(148,163,184,0.2)] hover:border-border-light'
    : variant === 'period'
      ? 'px-3 py-1 rounded-full text-sm bg-bg border border-border text-text-muted shrink-0 cursor-default hover:text-primary-light hover:border-primary/30 hover:shadow-[0_0_8px_rgba(124,58,237,0.3)] transition'
      : 'px-3 py-1 rounded-full text-sm bg-bg border border-border text-text-muted shrink-0 cursor-default transition hover:shadow-[0_0_6px_rgba(148,163,184,0.2)] hover:border-border-light'
---

<span class={cls}>{label}</span>

---
import BaseLayout from '../layouts/BaseLayout.astro'
import PrimaryButton from '../components/PrimaryButton.astro'
---

<BaseLayout title="Page Not Found" description="This page could not be found.">
  <div class="min-h-full flex items-center justify-center px-4 py-12 sm:py-16">
    <div class="gradient-border p-8 sm:p-12 text-center max-w-xl w-full">
      <p class="text-7xl sm:text-8xl font-bold gradient-text mb-4">404</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-text mb-3">This page doesn't exist</h1>
      <p class="text-text-muted mb-8 max-w-md mx-auto">
        The link may be broken, or the page may have moved. Head back to the homepage to see my
        projects.
      </p>
      <div class="flex justify-center">
        <PrimaryButton href="/" label="Back to Home" icon="home-solid" />
      </div>
    </div>
  </div>
</BaseLayout>

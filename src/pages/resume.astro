---
import { SITE_CONFIG, NAV_ITEMS } from '../data/config.ts'
import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={SITE_CONFIG.description} />
    <meta name="author" content={SITE_CONFIG.name} />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Résumé | {SITE_CONFIG.siteTitle}</title>
    <meta property="og:title" content="Résumé | {SITE_CONFIG.siteTitle}" />
    <meta property="og:description" content={SITE_CONFIG.description} />
    <meta property="og:image" content="https://gaganjain.vercel.app/og-image.png" />
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Gagan" />
    <meta property="profile:last_name" content="Jain" />
    <meta property="og:url" content="https://gaganjain.vercel.app/resume" />
    <link rel="canonical" href="https://gaganjain.vercel.app/resume" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Résumé | {SITE_CONFIG.siteTitle}" />
    <meta name="twitter:description" content={SITE_CONFIG.description} />
    <meta name="twitter:image" content="https://gaganjain.vercel.app/og-image.png" />
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Gagan Jain",
      "jobTitle": "AI / LLM Engineer",
      "url": "https://gaganjain.vercel.app",
      "sameAs": [
        "https://github.com/gaganjainse",
        "https://linkedin.com/in/gaganjainse"
      ],
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "VIT Vellore"
      },
      "knowsAbout": ["GenAI", "LLMs", "Agentic AI", "RAG", "Multi-Agent Systems", "MCP", "Fine-tuning", "QLoRA", "Prompt Engineering", "Python", "Rust", "FastAPI", "Flask", "React"]
    }
    </script>
  </head>
  <body>
    <script>
      window.location.replace('/résumé');
    </script>
    <p>Redirecting to <a href="/résumé">/résumé</a>...</p>
  </body>
</html>

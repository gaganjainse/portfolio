---
import { SITE_CONFIG, NAV_ITEMS } from '../data/config.js'
import '../styles/global.css'

const pageTitle = Astro.props.title
  ? `${Astro.props.title} | ${SITE_CONFIG.siteTitle}`
  : SITE_CONFIG.siteTitle

const pageDescription = Astro.props.description || SITE_CONFIG.description
const pageUrl = Astro.url.href
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE_CONFIG.name} />
    <meta name="theme-color" content="#7c3aed" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{pageTitle}</title>

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`https://gaganjain.vercel.app/og-image.png`} />
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Gagan" />
    <meta property="profile:last_name" content="Jain" />
    <meta property="og:url" content={pageUrl} />
    <link rel="canonical" href={Astro.props.canonical || pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`https://gaganjain.vercel.app/og-image.png`} />

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Gagan Jain",
      "jobTitle": "AI / LLM Engineer",
      "url": "https://gaganjain.vercel.app",
      "sameAs": [
        "https://github.com/gaganjainse",
        "https://linkedin.com/in/gaganjainse"
      ],
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "VIT Vellore"
      },
      "knowsAbout": ["GenAI", "LLMs", "Agentic AI", "RAG", "Multi-Agent Systems", "MCP", "Fine-tuning", "QLoRA", "Prompt Engineering", "Python", "Rust", "FastAPI", "Flask", "React"]
    }
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true" />
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header>
      <nav
        class="fixed top-0 left-0 right-0 z-50 glass border-b border-border/60 transition-all duration-300"
        aria-label="Main navigation"
      >
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="flex items-center justify-between h-16">
            <a
              href="/"
              class="text-lg sm:text-xl font-bold gradient-text hover:opacity-80 transition-opacity flex-shrink-0 truncate max-w-[140px] sm:max-w-none"
              aria-label="Go to top"
            >
              Gagan Jain
            </a>

            <div class="hidden md:flex items-center gap-1">
              {NAV_ITEMS.map((item) => (
                <a
                  href={`/#${item.id}`}
                  class="nav-link px-3 py-2 rounded-lg text-sm font-medium transition-all text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
                  data-nav={item.id}
                >
                  {item.label}
                </a>
              ))}
              <a
                href="/résumé"
                class="nav-link ml-2 px-3 py-2 rounded-lg text-sm font-medium transition-all text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
              >
                Résumé
              </a>
            </div>

            <button
              id="mobile-menu-btn"
              class="md:hidden p-2 text-text-muted hover:text-text rounded-lg hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20 transition-colors"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div id="mobile-menu" class="md:hidden hidden absolute top-16 right-4 min-w-[160px] bg-bg/95 backdrop-blur-xl rounded-xl border border-border shadow-2xl shadow-black/30 z-50">
            <div class="space-y-1 p-2">
              {NAV_ITEMS.map((item) => (
                <a
                  href={`/#${item.id}`}
                  class="nav-link block w-full text-left px-4 py-3 rounded-lg text-base font-medium transition-all text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
                  data-nav={item.id}
                >
                  {item.label}
                </a>
              ))}
              <a
                href="/résumé"
                class="nav-link block w-full text-left px-4 py-3 rounded-lg text-base font-medium transition-all text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
              >
                Résumé
              </a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main id="main-content" class="scroll-mt-16">
      <slot />
    </main>

    <footer class="py-8 px-4 sm:px-6 border-t border-border" role="contentinfo">
      <div class="max-w-6xl mx-auto text-center">
        <p class="text-text-muted text-sm mb-3">
          &copy; {new Date().getFullYear()} Gagan Jain &middot; Built with Astro + GSAP + Tailwind CSS
        </p>
        <div class="flex items-center justify-center gap-4 text-sm">
          <a href="/résumé"  class="nav-link px-3 py-2 rounded-lg text-sm font-medium transition-all text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20">
            Résumé
          </a>
          <span class="text-border">&middot;</span>
          <button onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" class="nav-link px-3 py-2 rounded-lg text-sm font-medium transition-all text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20">
            Back to top
          </button>
        </div>
      </div>
    </footer>

    <script>
      import { scrollProgress } from '../utils/gsap.ts'
      scrollProgress()

      const mobileMenuBtn = document.getElementById('mobile-menu-btn')
      const mobileMenu = document.getElementById('mobile-menu')
      const navLinks = document.querySelectorAll('.nav-link')

      if (mobileMenuBtn && mobileMenu) {
        const menuIconOpen = document.getElementById('menu-icon-open')
        const menuIconClose = document.getElementById('menu-icon-close')

        mobileMenuBtn.addEventListener('click', () => {
          const isHidden = mobileMenu.classList.contains('hidden')
          if (isHidden) {
            mobileMenu.classList.remove('hidden')
            mobileMenuBtn.setAttribute('aria-expanded', 'true')
            mobileMenuBtn.setAttribute('aria-label', 'Close menu')
            if (menuIconOpen) menuIconOpen.classList.add('hidden')
            if (menuIconClose) menuIconClose.classList.remove('hidden')
          } else {
            mobileMenu.classList.add('hidden')
            mobileMenuBtn.setAttribute('aria-expanded', 'false')
            mobileMenuBtn.setAttribute('aria-label', 'Open menu')
            if (menuIconOpen) menuIconOpen.classList.remove('hidden')
            if (menuIconClose) menuIconClose.classList.add('hidden')
          }
        })
      }

      navLinks.forEach(link => {
        link.addEventListener('click', () => {
          if (mobileMenu) mobileMenu.classList.add('hidden')
          if (mobileMenuBtn) {
            mobileMenuBtn.setAttribute('aria-expanded', 'false')
            mobileMenuBtn.setAttribute('aria-label', 'Open menu')
            const menuIconOpen = document.getElementById('menu-icon-open')
            const menuIconClose = document.getElementById('menu-icon-close')
            if (menuIconOpen) menuIconOpen.classList.remove('hidden')
            if (menuIconClose) menuIconClose.classList.add('hidden')
          }
        })
      })

      const sections = document.querySelectorAll('section[id]')
      const navItems = [...document.querySelectorAll('.nav-link')]

      function updateActiveSection() {
        if (window.location.pathname === '/résumé') {
          navItems.forEach(link => {
            link.classList.remove('active')
            if (link.getAttribute('href') === '/résumé') {
              link.classList.add('active')
            }
          })
          return
        }

        let currentSection = null
        const scrollPos = window.scrollY + 150

        sections.forEach(section => {
          const sectionTop = section.offsetTop
          const sectionHeight = section.offsetHeight
          if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
            currentSection = section.getAttribute('id')
          }
        })

        navItems.forEach(link => {
          link.classList.remove('active')
          if (link.getAttribute('data-nav') === currentSection) {
            link.classList.add('active')
          }
          if (currentSection === null && (link.getAttribute('href') === '/' || link.getAttribute('href') === '/#home')) {
            link.classList.add('active')
          }
        })
      }

      window.addEventListener('scroll', updateActiveSection, { passive: true })
      updateActiveSection()

      if (window.location.pathname === '/résumé') {
        navLinks.forEach(link => {
          link.classList.remove('active')
          if (link.getAttribute('href') === '/résumé') {
            link.classList.add('active')
          }
        })
      }

      const nav = document.querySelector('nav')
      if (nav) {
        window.addEventListener('scroll', () => {
          const currentScroll = window.scrollY
          if (currentScroll > 50) {
            nav.style.backdropFilter = 'blur(20px)'
            nav.style.borderBottomColor = 'rgba(30, 41, 59, 0.8)'
          } else {
            nav.style.backdropFilter = 'blur(12px)'
            nav.style.borderBottomColor = 'rgba(30, 41, 59, 0.6)'
          }
        }, { passive: true })
      }
    </script>
  </body>
</html>

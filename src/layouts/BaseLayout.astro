---
import { SITE_CONFIG, NAV_ITEMS } from '../data/config.ts'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import '../styles/global.css'
import BackgroundOrbs from '../components/BackgroundOrbs.astro'

const pageTitle =
  (Astro.props.title ?? Astro.props.frontmatter?.title)
    ? `${Astro.props.title ?? Astro.props.frontmatter?.title} | ${SITE_CONFIG.siteTitle}`
    : SITE_CONFIG.siteTitle

const pageDescription = Astro.props.description || SITE_CONFIG.description
const pageUrl = Astro.url.href

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_CONFIG.name,
  jobTitle: 'AI / LLM Engineer',
  url: SITE_CONFIG.siteUrl,
  sameAs: ['https://github.com/gaganjainse', 'https://linkedin.com/in/gaganjainse'],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'VIT Vellore',
  },
  knowsAbout: [
    'GenAI',
    'LLMs',
    'Agentic AI',
    'RAG',
    'Multi-Agent Systems',
    'MCP',
    'Fine-tuning',
    'QLoRA',
    'Prompt Engineering',
    'Python',
    'Rust',
    'FastAPI',
    'Flask',
    'React',
  ],
})
---

<html lang="en">
  <head>
    <script is:inline>
      // Apply theme before first paint to avoid flash: stored preference wins,
      // otherwise follow the system preference.
      ;(function () {
        try {
          var stored = localStorage.getItem('theme')
          var systemLight = window.matchMedia('(prefers-color-scheme: light)').matches
          document.documentElement.setAttribute(
            'data-theme',
            stored || (systemLight ? 'light' : 'dark'),
          )
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark')
        }
      })()
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE_CONFIG.name} />
    <meta name="theme-color" content="#7c3aed" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${SITE_CONFIG.siteUrl}/og-image.png`} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE_CONFIG.siteTitle} />
    <meta property="profile:first_name" content="Gagan" />
    <meta property="profile:last_name" content="Jain" />
    <meta property="og:url" content={pageUrl} />
    <link rel="canonical" href={Astro.props.canonical || pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${SITE_CONFIG.siteUrl}/og-image.png`} />

    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <BackgroundOrbs />
    <div class="scroll-progress" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header>
      <nav
        class="fixed top-0 left-0 right-0 z-50 glass border-b border-border/60 transition duration-300"
        aria-label="Main navigation"
      >
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="flex items-center justify-between h-16">
            <a
              href="/"
              class="text-lg sm:text-xl font-bold gradient-text hover:opacity-80 transition-opacity flex-shrink-0 truncate max-w-[140px] sm:max-w-none"
              aria-label="Go to top"
            >
              Gagan Jain
            </a>

            <div class="hidden md:flex items-center gap-1">
              {
                NAV_ITEMS.map((item) => (
                  <a
                    href={item.href ?? `/#${item.id}`}
                    class="nav-link px-3 py-2 rounded-lg text-sm font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
                    data-nav={item.id}
                  >
                    {item.label}
                  </a>
                ))
              }
              <a
                href="/resume"
                class="nav-link ml-2 px-3 py-2 rounded-lg text-sm font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
              >
                Résumé
              </a>
              <button
                class="theme-toggle ml-1 px-2.5 py-2 rounded-lg text-sm font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
                aria-label="Switch to light mode"
                type="button"
              >
                <svg
                  class="theme-icon-sun w-4 h-4 hidden"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                  ></path>
                </svg>
                <svg
                  class="theme-icon-moon w-4 h-4"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M21.64 13a1 1 0 00-1.05-.14 8.05 8.05 0 01-3.37.73 8.15 8.15 0 01-8.14-8.15 8.15 8.15 0 012.73-6.05A1 1 0 009.36 2.5 10.15 10.15 0 002 12.44a10.16 10.16 0 0010.16 10.16 10.15 10.15 0 009.46-6.27 1 1 0 00.02-.83z"
                  ></path>
                </svg>
              </button>
            </div>

            <button
              id="mobile-menu-btn"
              class="md:hidden p-2 text-text-muted hover:text-text rounded-lg hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20 transition-colors"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg
                id="menu-icon-open"
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
              <svg
                id="menu-icon-close"
                class="w-6 h-6 hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <div
            id="mobile-menu"
            class="md:hidden hidden absolute top-16 right-4 min-w-[160px] bg-bg/95 backdrop-blur-xl rounded-xl border border-border shadow-2xl shadow-black/30 z-50"
          >
            <div class="space-y-1 p-2">
              {
                NAV_ITEMS.map((item) => (
                  <a
                    href={item.href ?? `/#${item.id}`}
                    class="nav-link block w-full text-left px-4 py-3 rounded-lg text-base font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
                    data-nav={item.id}
                  >
                    {item.label}
                  </a>
                ))
              }
              <a
                href="/resume"
                class="nav-link block w-full text-left px-4 py-3 rounded-lg text-base font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
              >
                Résumé
              </a>
              <button
                class="theme-toggle block w-full text-left px-4 py-3 rounded-lg text-base font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
                aria-label="Switch to light mode"
                type="button"
              >
                <span class="flex items-center gap-3">
                  <svg
                    class="theme-icon-sun w-5 h-5 hidden"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                    ></path>
                  </svg>
                  <svg
                    class="theme-icon-moon w-5 h-5"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M21.64 13a1 1 0 00-1.05-.14 8.05 8.05 0 01-3.37.73 8.15 8.15 0 01-8.14-8.15 8.15 8.15 0 012.73-6.05A1 1 0 009.36 2.5 10.15 10.15 0 002 12.44a10.16 10.16 0 0010.16 10.16 10.15 10.15 0 009.46-6.27 1 1 0 00.02-.83z"
                    ></path>
                  </svg>
                  <span class="theme-label">Light mode</span>
                </span>
              </button>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main id="main-content" class="scroll-mt-16">
      <slot />
    </main>

    <footer class="py-8 px-4 sm:px-6 bg-bg-elevated/50" role="contentinfo">
      <div class="max-w-6xl mx-auto">
        <div class="gradient-border rounded-xl px-6 py-5 text-center">
          <p class="text-text-muted text-sm mb-3">
            &copy; {new Date().getFullYear()} Gagan Jain &middot; Built with Astro + GSAP + Tailwind CSS
          </p>
          <div class="flex items-center justify-center gap-4 text-sm">
            <a
              href="/resume"
              class="nav-link px-3 py-2 rounded-lg text-sm font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
            >
              Résumé
            </a>
            <a
              href="/docs/getting-started"
              class="nav-link px-3 py-2 rounded-lg text-sm font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
            >
              Docs
            </a>
            <span class="text-border">&middot;</span>
            <button
              id="back-to-top"
              class="nav-link px-3 py-2 rounded-lg text-sm font-medium transition text-text-muted hover:text-text hover:bg-gradient-to-r hover:from-primary/20 hover:to-accent/20"
            >
              Back to top
            </button>
          </div>
        </div>
      </div>
    </footer>

    <script>
      import { scrollProgress } from '../utils/dom.ts'
      scrollProgress()

      const mobileMenuBtn = document.getElementById('mobile-menu-btn')
      const mobileMenu = document.getElementById('mobile-menu')
      const navLinks = document.querySelectorAll('.nav-link')
      const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      let lastFocused: HTMLElement | null = null

      function closeMenu(returnFocus = false) {
        if (!mobileMenu || !mobileMenuBtn) return
        mobileMenu.classList.add('hidden')
        mobileMenuBtn.setAttribute('aria-expanded', 'false')
        mobileMenuBtn.setAttribute('aria-label', 'Open menu')
        const menuIconOpen = document.getElementById('menu-icon-open')
        const menuIconClose = document.getElementById('menu-icon-close')
        if (menuIconOpen) menuIconOpen.classList.remove('hidden')
        if (menuIconClose) menuIconClose.classList.add('hidden')
        if (returnFocus && lastFocused instanceof HTMLElement) lastFocused.focus()
      }

      function openMenu() {
        if (!mobileMenu || !mobileMenuBtn) return
        lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null
        mobileMenu.classList.remove('hidden')
        mobileMenuBtn.setAttribute('aria-expanded', 'true')
        mobileMenuBtn.setAttribute('aria-label', 'Close menu')
        const menuIconOpen = document.getElementById('menu-icon-open')
        const menuIconClose = document.getElementById('menu-icon-close')
        if (menuIconOpen) menuIconOpen.classList.add('hidden')
        if (menuIconClose) menuIconClose.classList.remove('hidden')
        const firstFocusable = mobileMenu.querySelector(focusableSelector)
        if (firstFocusable instanceof HTMLElement) firstFocusable.focus()
      }

      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener('click', () => {
          if (mobileMenu.classList.contains('hidden')) {
            openMenu()
          } else {
            closeMenu(true)
          }
        })

        // Focus trap: keep Tab/Shift+Tab inside the open menu, Escape to close
        document.addEventListener('keydown', (event) => {
          if (!mobileMenu || mobileMenu.classList.contains('hidden')) return

          if (event.key === 'Escape') {
            closeMenu(true)
            return
          }

          if (event.key === 'Tab') {
            const focusables = [...mobileMenu.querySelectorAll<HTMLElement>(focusableSelector)]
            if (focusables.length === 0) return
            const first = focusables[0]
            const last = focusables[focusables.length - 1]
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault()
              last.focus()
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault()
              first.focus()
            }
          }
        })
      }

      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          if (mobileMenu) closeMenu()
        })
      })

      const sections = document.querySelectorAll<HTMLElement>('section[id]')
      const navItems = [...document.querySelectorAll('nav .nav-link')]

      function updateActiveSection() {
        if (window.location.pathname === '/resume') {
          navItems.forEach((link) => {
            link.classList.remove('active')
            if (link.getAttribute('href') === '/resume') {
              link.classList.add('active')
            }
          })
          return
        }

        if (window.location.pathname.startsWith('/docs')) {
          navItems.forEach((link) => {
            link.classList.remove('active')
            if (link.getAttribute('data-nav') === 'docs') {
              link.classList.add('active')
            }
          })
          return
        }

        let currentSection: string | null = null
        const scrollPos = window.scrollY + 150

        sections.forEach((section) => {
          const sectionTop = section.offsetTop
          const sectionHeight = section.offsetHeight
          if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
            currentSection = section.getAttribute('id')
          }
        })

        // At (or very near) the bottom of the page the offset math can miss the
        // last section, leaving nothing active — force the final section then.
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
          const last = sections[sections.length - 1]
          if (last) currentSection = last.getAttribute('id')
        }

        navItems.forEach((link) => {
          link.classList.remove('active')
          if (link.getAttribute('data-nav') === currentSection) {
            link.classList.add('active')
          }
          if (
            currentSection === null &&
            (link.getAttribute('href') === '/' || link.getAttribute('href') === '/#home')
          ) {
            link.classList.add('active')
          }
        })
      }

      let ticking = false
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return
          ticking = true
          requestAnimationFrame(() => {
            updateActiveSection()
            ticking = false
          })
        },
        { passive: true },
      )
      updateActiveSection()

      const backToTop = document.getElementById('back-to-top')
      if (backToTop) {
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' })
        })
      }

      // ---- theme toggle (stored preference wins; system is the default) ----
      const themeToggles = document.querySelectorAll('.theme-toggle')
      const themeRoot = document.documentElement
      const systemLightQuery = window.matchMedia('(prefers-color-scheme: light)')

      function applyTheme(theme: string) {
        const isLight = theme === 'light'
        themeRoot.setAttribute('data-theme', theme)
        themeToggles.forEach((btn) => {
          btn.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode')
          const sun = btn.querySelector('.theme-icon-sun')
          const moon = btn.querySelector('.theme-icon-moon')
          const label = btn.querySelector('.theme-label')
          if (sun) sun.classList.toggle('hidden', !isLight)
          if (moon) moon.classList.toggle('hidden', isLight)
          if (label) label.textContent = isLight ? 'Dark mode' : 'Light mode'
        })
      }

      themeToggles.forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = themeRoot.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
          try {
            localStorage.setItem('theme', next)
          } catch (e) {
            /* storage unavailable — still switch for this session */
          }
          applyTheme(next)
        })
      })

      // Follow the system preference while the user hasn't chosen explicitly.
      systemLightQuery.addEventListener('change', (e) => {
        try {
          if (!localStorage.getItem('theme')) applyTheme(e.matches ? 'light' : 'dark')
        } catch (err) {
          /* ignore */
        }
      })

      applyTheme(themeRoot.getAttribute('data-theme') || 'dark')
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>

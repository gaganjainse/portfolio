---
import BaseLayout from './BaseLayout.astro'
import Icon from '../components/Icon.astro'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props

const DOC_ORDER = [
  '/docs/getting-started',
  '/docs/architecture',
  '/docs/adr',
  '/docs/site-map',
  '/docs/projects/nexusaos',
  '/docs/projects/nexus-kernel',
  '/docs/projects/seshaos',
  '/docs/projects/rag-service',
  '/docs/projects/llm-eval-harness',
  '/docs/projects/vyakrti',
  '/docs/projects/aim',
  '/docs/projects/fwrs',
]

const DOCS = [
  { href: '/docs/getting-started', label: 'Getting Started', section: 'Overview' },
  { href: '/docs/architecture', label: 'Architecture', section: 'Overview' },
  { href: '/docs/adr', label: 'ADRs', section: 'Overview' },
  { href: '/docs/site-map', label: 'Site Map', section: 'Overview' },
  { href: '/docs/projects/nexusaos', label: 'NexusAOS', section: 'Projects' },
  { href: '/docs/projects/nexus-kernel', label: 'nexus-kernel', section: 'Projects' },
  { href: '/docs/projects/seshaos', label: 'SeshaOS', section: 'Projects' },
  { href: '/docs/projects/rag-service', label: 'RAG Service', section: 'Projects' },
  { href: '/docs/projects/llm-eval-harness', label: 'LLM Eval Harness', section: 'Projects' },
  { href: '/docs/projects/vyakrti', label: 'Vyākṛti', section: 'Projects' },
  { href: '/docs/projects/aim', label: 'AIM', section: 'Projects' },
  { href: '/docs/projects/fwrs', label: 'FWRS', section: 'Projects' },
]

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/docs/getting-started'
const currentIndex = DOC_ORDER.findIndex((p) => currentPath === p)
const prev = currentIndex > 0 ? DOCS[currentIndex - 1] : null
const next =
  currentIndex >= 0 && currentIndex < DOC_ORDER.length - 1 ? DOCS[currentIndex + 1] : null

const SECTIONS = [...new Set(DOCS.map((d) => d.section))]

const navBtnClass =
  'inline-flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-4 py-1.5 sm:py-2 rounded-lg text-xs sm:text-sm font-medium border transition min-w-0'
---

<BaseLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-24 sm:pt-28 pb-16">
    <div class="flex flex-col lg:flex-row gap-8">
      {/* ---- Left sidebar nav (desktop) ---- */}
      <aside class="hidden lg:block w-64 shrink-0">
        <nav
          class="glow-card sticky top-24 border border-border-light/60 rounded-2xl bg-bg-card/60 backdrop-blur-sm p-5 space-y-6"
          aria-label="Docs navigation"
        >
          <p class="text-xs font-bold uppercase tracking-wider gradient-text mb-2">Documentation</p>
          {
            SECTIONS.map((section) => (
              <div>
                <p class="text-xs font-bold uppercase tracking-wider gradient-text mb-2">
                  {section}
                </p>
                <ul class="space-y-0.5 border-l border-border">
                  {DOCS.filter((d) => d.section === section).map((doc) => (
                    <li>
                      <a
                        href={doc.href}
                        class={`block border-l-2 -ml-px py-1.5 pl-3 text-sm transition ${
                          doc.href === currentPath
                            ? 'border-primary text-text font-medium bg-primary/10'
                            : 'border-transparent text-text-muted hover:text-text hover:border-primary/40'
                        }`}
                      >
                        {doc.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      {/* ---- Mobile docs dropdown — custom, styled like the site cards ---- */}
      <div class="lg:hidden docs-dropdown relative" data-docs-dropdown>
        <button
          type="button"
          class="docs-dropdown-btn glow-card w-full flex items-center justify-between gap-2 border border-border-light/60 rounded-xl bg-bg-card/60 backdrop-blur-sm px-4 py-3 text-sm font-medium text-text cursor-pointer"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="truncate" data-docs-current>
            {DOCS.find((d) => d.href === currentPath)?.label ?? 'Getting Started'}
          </span>
          <Icon
            name="chevron-down"
            class="docs-dropdown-chevron w-4 h-4 text-text-muted shrink-0 transition-transform"
          />
        </button>
        <div
          class="docs-dropdown-list hidden absolute left-0 right-0 top-full mt-2 z-30 rounded-xl border border-border bg-bg/95 backdrop-blur-xl shadow-2xl shadow-black/30 p-2 max-h-[60vh] overflow-y-auto"
          role="listbox"
          aria-label="Docs navigation"
        >
          {
            SECTIONS.map((section) => (
              <div class="mb-1">
                <p class="text-xs font-bold uppercase tracking-wider gradient-text px-3 py-1.5">
                  {section}
                </p>
                {DOCS.filter((d) => d.section === section).map((doc) => (
                  <a
                    href={doc.href}
                    role="option"
                    aria-selected={doc.href === currentPath}
                    class={`block px-3 py-2 rounded-lg text-sm transition ${
                      doc.href === currentPath
                        ? 'bg-primary/10 text-text font-medium'
                        : 'text-text-muted hover:text-text hover:bg-bg-elevated'
                    }`}
                  >
                    {doc.label}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      {/* ---- Main content ---- */}
      <div class="flex-1 min-w-0">
        {/* Previous | Home | Next — fixed in a 3-column grid: edges + center */}
        <div
          class="glow-card border border-border-light/60 rounded-xl bg-bg-card/60 backdrop-blur-sm p-2 sm:p-3 mb-6 grid grid-cols-3 items-center gap-1 sm:gap-2 no-print"
        >
          {/* Previous — anchored left, grows right */}
          <div class="justify-self-stretch min-w-0">
            {
              prev ? (
                <a
                  href={prev.href}
                  class={`${navBtnClass} w-full bg-bg text-text-muted border-border hover:text-text hover:border-primary/40`}
                >
                  <Icon name="chevron-left" class="w-4 h-4 shrink-0" />
                  <span class="truncate">{prev.label}</span>
                </a>
              ) : (
                <span
                  class={`${navBtnClass} w-full bg-bg text-text-muted/40 border-border cursor-not-allowed`}
                >
                  <Icon name="chevron-left" class="w-4 h-4 shrink-0" />
                  <span class="truncate">Previous</span>
                </span>
              )
            }
          </div>

          {/* Home — always centered, fixed */}
          <div class="justify-self-center min-w-0">
            <a
              href="/docs/getting-started"
              class={`${navBtnClass} bg-bg text-text-muted border-border hover:text-text hover:border-primary/40`}
            >
              <Icon name="home-solid" class="w-4 h-4 shrink-0" />
              <span class="truncate">Home</span>
            </a>
          </div>

          {/* Next — anchored right, grows left */}
          <div class="justify-self-stretch min-w-0">
            {
              next ? (
                <a
                  href={next.href}
                  class={`${navBtnClass} w-full bg-bg text-text-muted border-border hover:text-text hover:border-primary/40`}
                >
                  <span class="truncate">{next.label}</span>
                  <Icon name="chevron-right" class="w-4 h-4 shrink-0" />
                </a>
              ) : (
                <span
                  class={`${navBtnClass} w-full bg-bg text-text-muted/40 border-border cursor-not-allowed`}
                >
                  <span class="truncate">Next</span>
                  <Icon name="chevron-right" class="w-4 h-4 shrink-0" />
                </span>
              )
            }
          </div>
        </div>

        {/* Bordered wrapper card */}
        <div
          class="glow-card border border-border-light/60 rounded-2xl bg-bg-card/60 backdrop-blur-sm p-6 sm:p-10 shadow-2xl shadow-black/20 docs-sheet"
        >
          <slot />
        </div>
      </div>
    </div>
  </div>

  <script>
    const docsDropdown = document.querySelector<HTMLElement>('[data-docs-dropdown]')
    if (docsDropdown) {
      const btn = docsDropdown.querySelector<HTMLButtonElement>('.docs-dropdown-btn')
      const list = docsDropdown.querySelector<HTMLElement>('.docs-dropdown-list')
      const chevron = docsDropdown.querySelector<HTMLElement>('.docs-dropdown-chevron')

      const close = () => {
        list?.classList.add('hidden')
        chevron?.classList.remove('rotate-180')
        btn?.setAttribute('aria-expanded', 'false')
      }

      btn?.addEventListener('click', (e) => {
        e.stopPropagation()
        const isOpen = !list?.classList.contains('hidden')
        if (isOpen) {
          close()
        } else {
          list?.classList.remove('hidden')
          chevron?.classList.add('rotate-180')
          btn?.setAttribute('aria-expanded', 'true')
        }
      })

      // Close on outside click or Escape.
      document.addEventListener('click', (e) => {
        if (docsDropdown && !docsDropdown.contains(e.target as Node)) close()
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close()
      })
    }
  </script>
</BaseLayout>

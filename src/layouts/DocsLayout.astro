---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props

const DOC_ORDER = [
  '/docs/getting-started',
  '/docs/architecture',
  '/docs/adr',
  '/docs/projects/nexusaos',
  '/docs/projects/nexus-kernel',
  '/docs/projects/seshaos',
  '/docs/projects/rag-service',
  '/docs/projects/llm-eval-harness',
  '/docs/projects/vyakrti',
  '/docs/projects/aim',
  '/docs/projects/fwrs',
]

const DOCS = [
  { href: '/docs/getting-started', label: 'Getting Started', section: 'Overview' },
  { href: '/docs/architecture', label: 'Architecture', section: 'Overview' },
  { href: '/docs/adr', label: 'ADRs', section: 'Overview' },
  { href: '/docs/projects/nexusaos', label: 'NexusAOS', section: 'Projects' },
  { href: '/docs/projects/nexus-kernel', label: 'nexus-kernel', section: 'Projects' },
  { href: '/docs/projects/seshaos', label: 'SeshaOS', section: 'Projects' },
  { href: '/docs/projects/rag-service', label: 'RAG Service', section: 'Projects' },
  { href: '/docs/projects/llm-eval-harness', label: 'LLM Eval Harness', section: 'Projects' },
  { href: '/docs/projects/vyakrti', label: 'Vyākṛti', section: 'Projects' },
  { href: '/docs/projects/aim', label: 'AIM', section: 'Projects' },
  { href: '/docs/projects/fwrs', label: 'FWRS', section: 'Projects' },
]

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/docs/getting-started'
const currentIndex = DOC_ORDER.findIndex((p) => currentPath === p)
const prev = currentIndex > 0 ? DOCS[currentIndex - 1] : null
const next =
  currentIndex >= 0 && currentIndex < DOC_ORDER.length - 1 ? DOCS[currentIndex + 1] : null

const SECTIONS = ['Overview', 'Projects']

const navBtnClass =
  'inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium border transition'
---

<BaseLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-24 sm:pt-28 pb-16">
    <div class="flex flex-col lg:flex-row gap-8">
      {/* ---- Left sidebar nav (desktop) ---- */}
      <aside class="hidden lg:block w-64 shrink-0">
        <nav
          class="glow-card sticky top-24 border border-border-light/60 rounded-2xl bg-bg-card/60 backdrop-blur-sm p-5 space-y-6"
          aria-label="Docs navigation"
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-text-muted">
            Documentation
          </p>
          {
            SECTIONS.map((section) => (
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-2">
                  {section}
                </p>
                <ul class="space-y-0.5 border-l border-border">
                  {DOCS.filter((d) => d.section === section).map((doc) => (
                    <li>
                      <a
                        href={doc.href}
                        class={`block border-l-2 -ml-px py-1.5 pl-3 text-sm transition ${
                          doc.href === currentPath
                            ? 'border-primary text-text font-medium bg-primary/10'
                            : 'border-transparent text-text-muted hover:text-text hover:border-primary/40'
                        }`}
                      >
                        {doc.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      {/* ---- Mobile docs selector ---- */}
      <div class="lg:hidden">
        <label class="sr-only" for="docs-mobile-nav">Docs navigation</label>
        <select
          id="docs-mobile-nav"
          class="w-full px-3 py-2 rounded-lg text-sm bg-bg-card border border-border text-text"
          data-docs-select="true"
        >
          {
            DOCS.map((doc) => (
              <option value={doc.href} selected={doc.href === currentPath}>
                {doc.section} — {doc.label}
              </option>
            ))
          }
        </select>
      </div>

      {/* ---- Main content ---- */}
      <div class="flex-1 min-w-0">
        {/* Previous | Home | Next — fixed in a 3-column grid: edges + center */}
        <div
          class="glow-card border border-border-light/60 rounded-xl bg-bg-card/60 backdrop-blur-sm p-3 mb-6 grid grid-cols-3 items-center gap-2 no-print"
        >
          {/* Previous — anchored left, grows right */}
          <div class="justify-self-start min-w-0">
            {
              prev ? (
                <a
                  href={prev.href}
                  class={`${navBtnClass} bg-bg text-text-muted border-border hover:text-text hover:border-primary/40`}
                >
                  <svg
                    class="w-4 h-4 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                  <span class="truncate">{prev.label}</span>
                </a>
              ) : (
                <span
                  class={`${navBtnClass} bg-bg text-text-muted/40 border-border cursor-not-allowed`}
                >
                  <svg
                    class="w-4 h-4 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                  <span class="truncate">Previous</span>
                </span>
              )
            }
          </div>

          {/* Home — always centered, fixed */}
          <div class="justify-self-center">
            <a
              href="/docs/getting-started"
              class={`${navBtnClass} bg-bg text-text-muted border-border hover:text-text hover:border-primary/40`}
            >
              <svg
                class="w-4 h-4 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10h14V10"
                ></path>
              </svg>
              <span class="truncate">Home</span>
            </a>
          </div>

          {/* Next — anchored right, grows left */}
          <div class="justify-self-end min-w-0">
            {
              next ? (
                <a
                  href={next.href}
                  class={`${navBtnClass} bg-bg text-text-muted border-border hover:text-text hover:border-primary/40`}
                >
                  <span class="truncate">{next.label}</span>
                  <svg
                    class="w-4 h-4 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ) : (
                <span
                  class={`${navBtnClass} bg-bg text-text-muted/40 border-border cursor-not-allowed`}
                >
                  <span class="truncate">Next</span>
                  <svg
                    class="w-4 h-4 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              )
            }
          </div>
        </div>

        {/* Bordered wrapper card */}
        <div
          class="glow-card border border-border-light/60 rounded-2xl bg-bg-card/60 backdrop-blur-sm p-6 sm:p-10 shadow-2xl shadow-black/20 docs-sheet"
        >
          <slot />
        </div>
      </div>
    </div>
  </div>

  <script>
    const docsSelect = document.querySelector<HTMLSelectElement>('[data-docs-select]')
    if (docsSelect) {
      docsSelect.addEventListener('change', () => {
        window.location.href = docsSelect.value
      })
    }
  </script>
</BaseLayout>
